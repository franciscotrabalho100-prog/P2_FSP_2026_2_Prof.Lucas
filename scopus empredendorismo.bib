@ARTICLE{Enriquez2022601,
	author = {Enriquez, Falina},
	title = {ANTHROPOLOGICAL CURRENTS: REPORT How to “Get By” in a Crisis Strategic Flexibility among Brazilian Musical Entrepreneurs},
	year = {2022},
	journal = {Current Anthropology},
	volume = {63},
	number = {5},
	pages = {601 - 607},
	doi = {10.1086/721956},
	url = {https://www.scopus.com/pages/publications/85140124295?origin=resultslist},
	affiliations = {Department of Anthropology, University of Wisconsin–Madison, 1180 Observatory Drive, Madison, 53706, WI, United States},
	abstract = {During the twenty-first century, in Recife, Brazil, musicians and promoters in the city’s alternative music scene benefited from an unprecedented amount of state sponsorship. However, because of an economic recession, since 2014 they have been contending with precarity: a lack of reliable employment and decreased state support. In order to “get by” (se virar), these professionals are becoming more entrepreneurial, but they are also defying the alienation of neoliberalism and precarity by fostering belonging through collaboration and by creating a poetics of precarity founded on intimacy. I analyze such tactics in relation to Charles Carnegie’s concept of “strategic flexibility,” a form of agency attributed to informal, working-class workers but that has become crucial among middle-class people like Recife’s alternative scene professionals, whose aspirations for stability have been eroded by precarity. My interlocutors embrace entrepreneurship, but music, like other art forms, enables relationships and sensibilities that challenge hegemonic norms and subjectivities. When considered in relation to artistic labor, then, strategic flexibility can offer a way to analyze the destructive and productive effects of precarity while also diverging from dichotomously evaluating contemporary practices as forms of either accommodation or resistance to neoliberalism. © 2022 The Wenner-Gren Foundation for Anthropological Research. All rights reserved.},
	correspondence_address = {F. Enriquez; Department of Anthropology, University of Wisconsin–Madison, Madison, 1180 Observatory Drive, 53706, United States; email: fenriquez2@wisc.edu},
	publisher = {University of Chicago Press},
