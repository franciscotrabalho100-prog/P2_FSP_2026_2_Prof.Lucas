	affiliations = {Innovation Department, Ministry of Science, Technology and Innovation (MCTI), Brasília, Brazil; Master’s course in Innovation and Technology Transfer (PROFNIT), University of Brasilia (UnB), Brasilia, Brazil; Master’s course in Innovation and Technology Transfer (PROFNIT), Federal Institute of Bahia (IFBA), Salvador, Brazil},
