@ARTICLE{Filho202481,
	author = {Filho, Roberto Fragale and Lima, Marina Dos Santos},
	title = {Someone Came in Between: Digital Intermediation Models for Domestic Work in Brazil; [Alguém se meteu no meio: modelos de intermediação digital do trabalho doméstico no Brasil]; [Alguien se puso en medio: modelos de intermediación digital del trabajo doméstico en Brasil]},
	year = {2024},
	journal = {Revista de Estudios Sociales},
	volume = {2024},
