	keywords = {Brazil; Conservation of Natural Resources; Ethnobotany; Fabaceae; Fruit; Game Theory; Humans; Interviews as Topic; Plant Extracts; Plants, Medicinal; Socioeconomic Factors; Theales; Apodi; Caryocar; Caryocar brasiliense; Dimorphandra; plant extract; Brazil; economics; environmental protection; Ericales; ethnobotany; Fabaceae; fruit; game; human; interview; medicinal plant; procedures; socioeconomics},
	correspondence_address = {U.P. Albuquerque; Universidade Federal Rural de Pernambuco, Departamento de Biologia, Laboratório de Etnobiologia Aplicada e Teórica, Recife, Pernambuco, Avenida Dom Manoel de Medeiros, Dois irmãos, CEP: 52171-900, Brazil; email: upa@db.ufrpe.br},
