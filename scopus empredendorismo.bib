	author = {Hidalgo, Gisele and Faccin, Kadigia},
	title = {Public policies for fostering the entrepreneurship industry: unlocking the black box of collaborative governance mechanisms in ecosystems; [Políticas públicas para o fomento da indústria do empreendedorismo: desvendando a caixa-preta dos mecanismos de governança colaborativa em ecossistemas]; [Políticas públicas para el fomento de la industria del emprendimiento: descifrando la caja negra de los mecanismos de gobernanza colaborativa en ecosistemas]},
