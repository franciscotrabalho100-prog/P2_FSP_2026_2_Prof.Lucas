@ARTICLE{Brunelli2026,
	author = {Brunelli, Mariana de Queiroz and Cavazotte, Flavia and Furtado, Liliane},
	title = {Leading Social Entrepreneurship Teams: Empowering Leadership and Dynamic Capabilities as Drivers of Creativity and Innovation},
	year = {2026},
	journal = {Journal of Social Entrepreneurship},
	pages = {},
	doi = {10.1080/19420676.2026.2681985},
	url = {https://www.scopus.com/pages/publications/105041295140?origin=resultslist},
	affiliations = {IAG Business School, Pontifical Catholic University of Rio de Janeiro (PUC-RJ), Rio de Janeiro, Brazil; Coppead Graduate School of Business, Federal University of Rio de Janeiro (COPPEAD/UFRJ), Rio de Janeiro, Brazil},
	abstract = {Social ventures operate at the intersection of business and social mission, facing competing institutional logics and scarce resources while striving to generate sustainable social impact. To navigate these challenges, leadership plays a crucial role in enabling team processes that foster creativity and innovation. Building on the resource-based view and the dynamic capabilities framework, this study examines how empowering leadership–characterised by delegation, autonomy and participative decision-making–enhances team creativity and innovation in social ventures. Specifically, we test a sequential mediation model in which empowering leadership influences team innovation through team dynamic capabilities and team creativity, controlling for servant leadership. Data were collected from social ventures operating in Brazil. Results indicate that empowering leadership positively affects team dynamic capabilities. The indirect effects of empowering leadership on both creativity and innovation were also significant. These findings highlight empowering leadership as a critical trigger of adaptive and creative team processes that sustain innovation in social ventures. © 2026 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {Empowering leadership; social ventures; team creativity; team dynamic capabilities; team innovation},
	correspondence_address = {L. Furtado; Coppead Graduate School of Business (COPPEAD/UFRJ), Rio de Janeiro, Rua Pascoal Lemme, 355 – Cidade Universitária, Brazil; email: liliane.furtado@coppead.ufrj.br},
	publisher = {Routledge},
	issn = {19420676},
	language = {English},
	abbrev_source_title = {J. Soc. Entrep.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

