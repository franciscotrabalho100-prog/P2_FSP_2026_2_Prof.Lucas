	issn = {25158961},
	language = {English},
	abbrev_source_title = {Innov. Manag. Rev.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9; All Open Access; Gold Open Access; Green Open Access}
