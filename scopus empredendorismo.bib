@ARTICLE{Lima2024749,
	author = {Lima, André Nicacio},
	title = {The crimes of Wursten & Company: German-speaking slaveholding entrepreneurs in Brazil (1808-1888); [Os crimes de Wursten & Companhia: empreendedores escravistas de língua alemã no Brasil (1808-1888)]},
