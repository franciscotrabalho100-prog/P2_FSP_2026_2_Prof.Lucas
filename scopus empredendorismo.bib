@ARTICLE{Kuzma2025,
	author = {Kuzma, Edson Luis and Lopes, Dayane Loren and Massuga, Flavia and Sehnem, Simone and Gomes, Myller Augusto dos Santos},
	title = {Deciphering sustainable entrepreneurial DNA: development and validation of a measurement scale for future managers in emergent markets},
	year = {2025},
	journal = {Journal of Entrepreneurship in Emerging Economies},
	pages = {},
	doi = {10.1108/JEEE-01-2025-0018},
	url = {https://www.scopus.com/pages/publications/105023162498?origin=resultslist},
	affiliations = {Universidade Federal do Paraná, Curitiba, Brazil; Universidade Estadual do Centro-Oeste, Guarapuava, Brazil; Universidade do Oeste de Santa Catarina, Chapecó, Brazil; Instituto Federal do Parana, Curitiba, Brazil},
	abstract = {Purpose – This study aims to develop and validate a measurement scale capable of identifying and evaluating the factors that influence sustainable entrepreneurship in the context of students of management courses in emerging economies. Design/methodology/approach – To achieve this objective, a methodological protocol was adopted with steps that included a systematic literature review, content and face validation with experts, pilot testing, final data collection and confirmatory factor analysis (CFA). The final sample consisted of 249 respondents from different regions of Brazil. Findings – The results indicated the robustness of the proposed scale, with high reliability indices (overall Cronbach's alpha of 0.947) and internal consistency for all constructs. Factor analysis resulted in the validation of six main factors: attitude, feasibility, benefits, behavior, sustainable entrepreneurial intention and incentives. The division of the behavior factor into two new constructs reinforced the complexity of the phenomenon studied. Research limitations/implications – One of the main limitations of this study is that the validation of the sustainable entrepreneurship measurement scale was conducted exclusively in higher education institutions in Brazil, a country with distinct socioeconomic, cultural and political characteristics. The Brazilian context is marked by regional disparities, structural challenges and economic dynamics that influence both higher education and entrepreneurial behavior. Practical implications – The theoretical and academic contributions of this study are related to the improvement of knowledge about the measurement of complex phenomena, such as sustainable entrepreneurship, in a higher education context. The validation of the proposed scale strengthens the literature by providing empirical evidence on the multifactorial structure of this phenomenon, demonstrating that it is composed of interrelated dimensions, such as attitudes, feasibility, perceived benefits, behaviors and sustainable intentions. Social implications – The social contributions of this study are manifested in the potential influence that measuring sustainable entrepreneurship can have on the training of future leaders and managers committed to sustainable practices. By validating a specific scale to assess attitudes, behaviors and intentions related to sustainable entrepreneurship, this study provides support for educational institutions and educational managers to develop policies and curricula that promote skills and values focused on sustainability. Originality/value – This research contributes to theoretical and practical advancement, offering an instrument adapted to the context of emerging countries, capable of supporting educational interventions and public policies aimed at training sustainable entrepreneurs. © 2025 Emerald Publishing Limited},
	author_keywords = {Higher education in management; Scale development; Scale validation; Sustainability; Sustainable entrepreneurship},
	publisher = {Emerald Publishing},
	issn = {20534604},
	language = {English},
	abbrev_source_title = {J. Enterpr. Emerg. Econ.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

