@ARTICLE{Da Silva20251,
	author = {Da Silva, Gabriel Italo Novaes and Dos Santos, Agda Raiany Mota and Da Silva, Marcelo José and Do Nascimento Araújo, George and Da Rosa Ferraz Jardim, Alexandre Maniçoba and De Morais, José Edson Florentino and De Souza, Carlos André Alves and Steidle Neto, Antonio José and Souza, Luciana Sandra Bastosde and Silva, José Raliuson Inácio and Silveira, Ana Virgínia Marinho and De Assunção Montenegro, Abelardo Antônio and Da Silva, Thieres George Freire},
	title = {Management strategies in a semiarid environment for forage cactus cultivation to balance growth, development, forage productivity and indicators of water efficiency and economics},
	year = {2025},
	journal = {Journal of Agricultural Science},
	volume = {164},
	pages = {1 - 19},
	doi = {10.1017/S0021859625100440},
	url = {https://www.scopus.com/pages/publications/105024849277?origin=resultslist},
	affiliations = {Federal Rural University of Pernambuco, Departament of Agricultural Engineering, Dom Manoel de Medeiros Avenue, s/n, Dois Irmãos, Recife, Brazil; Federal University of Alagoas, UFAL, Departament of Agronomy, AL, Rio Largo, Br-104, Brazil; Department of Biodiversity, Institute of Bioscience, São Paulo State University - UNESP, Av. 24A, 1515, SP, Rio Claro, Brazil; Academic Unit of Serra Talhada, Federal Rural University of Pernambuco, Gregório Ferraz Nogueira Avenue, s/n, PE, Serra Talhada, Brazil; Federal University of São João del-Rei, Departament of Agronomy, Campus Sete Lagoas, MG, Sete Lagoas, Brazil},
	abstract = {Different cutting intervals can influence crop development. Therefore, knowledge of the interaction between growth factors and soil-plant-atmosphere conditions can contribute to the efficient cultivation of forage cactus. The objective of this study was to evaluate morphophysiological characteristics, production and water and economic indicators in forage cactus clones subjected to different cutting interval. The study was conducted in Serra Talhada, Pernambuco, in a 3 × 4 factorial arrangement, with three forage cactus clones (‘Orelha de Elefante Mexicana, OEM’-Opuntia stricta; ‘Miúda’ and ‘IPA Sertânia’-Nopalea cochenillifera) and four cutting intervals (6, 9, 12 + 6 and 18 months) in randomised blocks, with four replications. Biometric and productive measurements were performed to determine the phenophases and cutting times. The components of the soil water balance (SWB) were considered at a depth of 0.60 m and the indicators were analysed. The Absolute Growth Rate-AGR and Relative Growth Rate-RGR were higher for the OEM clone at a interval of 18 months. The highest productions of fresh mass (FM) (286.4 Mg/ha) and dry matter (DM) (21.4 Mg/ha) occurred in the OEM clone regardless of the cutting interval. The MIU clone presented three phenophases. The water use efficiency indicator (*WUEc, 1.5 kg/m<sup>3</sup>) and crop water productivity (*WPc, 1.3 kg/m<sup>3</sup>) were improved in treatments with the OEM clone, as well as the gross economic productivity of water via irrigation (PBEAi, 2.98 US$/m<sup>3</sup>). It is recommended to cultivate the OEM clone of forage cactus, regardless of the cutting interval, to provide greater productivity and economic benefits. © The Author(s), 2025. Published by Cambridge University Press.},
	author_keywords = {absolute growth rate; cutting interval; dry matter production; phenophase; relative growth rate},
	keywords = {Brazil; Pernambuco; cactus; cultivation; cutting (process); dry matter; soil water; water budget; water use efficiency},
	correspondence_address = {G.I.N. Da Silva; Federal Rural University of Pernambuco, Departament of Agricultural Engineering, Recife, Dom Manoel de Medeiros Avenue, s/n, Dois Irmãos, Brazil; email: Gabriel.italo@gmail.com},
	publisher = {Cambridge University Press},
	issn = {00218596},
	coden = {JASIA},
	language = {English},
	abbrev_source_title = {J. Agric. Sci.},
	type = {Article},
